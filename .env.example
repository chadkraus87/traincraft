NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No service-role key. Every Supabase client in this app uses the anon key so
# row-level security is always in force; a service-role key bypasses every
# policy, and nothing here needs that. Don't reintroduce it without confining
# it to a single server-only module.
ANTHROPIC_API_KEY=

# Error monitoring (optional). With no DSN, Sentry initialises to a no-op and
# the app runs identically — you don't need a Sentry account to develop here.
# NEXT_PUBLIC_SENTRY_DSN is public by design; it only permits sending events.
# Cloudflare Turnstile site key (public). Set this ONLY when CAPTCHA
# protection is enabled in Supabase — the two are two halves of one switch.
# Supabase rejects every auth request without a token once CAPTCHA is on, so
# turning it on there without a key here locks everyone out of the app.
# Leave blank and no widget renders and no token is sent, matching a project
# with CAPTCHA disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time, so stack traces aren't
# minified. Builds succeed without it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# No email or SMS credentials are stored server-side. Plan delivery uses
# the trainer's own device (share sheet or mail app) — see
# src/components/DeliverButtons.tsx. SMS was removed entirely; see
# src/app/plans/[id]/page.tsx history for how it worked if you want it back.
